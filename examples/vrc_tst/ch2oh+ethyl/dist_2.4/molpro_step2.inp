 {multi;closed,16;occ,18;wf, 34,1,2,;state,1;maxiter,40}
  {rs2,maxiti=2000,shift=0.2;orbital,IGNORE_ERROR ;state,1}
  en_t = energy
 
 ! coupled cluster on triplet
