 {multi;closed,16;occ,18;wf, 34,1,2,;state,1;maxiter,40;canorb,2101.2}
 {rhf;wf, 34,1,2;start,2101.2}
 !  CC_CC
 {uccsd(t)}
 
  en_cc = energy
 
   CBSen = en_cc - (en_t - en_s)
   put,molden,molpro.molden
 
