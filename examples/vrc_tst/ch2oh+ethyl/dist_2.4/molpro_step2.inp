 !closed shell input
 nosym
 
 ! generate AS
 uhf
 SET,SPIN=           0
 {multi;closed,16;occ,18;wf, 34,1,0,;state,1;maxiter,40}
 End1

 {multi;closed,16;occ,18;wf, 34,1,0,;state,1;maxiter,40}
 
   basis=aug-cc-pvtz
   ! singlet caspt2
 SET,SPIN=           0
 {multi;closed,16;occ,18;wf, 34,1,0,;state,1;maxiter,40}
  {rs2,maxiti=2000,shift=0.2;orbital,IGNORE_ERROR ;state,1}
   en_s = energy
 
   ! triplet caspt2
