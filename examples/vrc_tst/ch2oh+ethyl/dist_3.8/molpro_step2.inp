 !closed shell input
 nosym
 
 ! generate AS
 uhf
 SET,SPIN=           0
 {multi;closed,16;occ,18;wf, 34,1,0,;state,1;maxiter,40}
 End1

 {multi;closed,16;occ,18;wf, 34,1,0,;state,1;maxiter,40}
 
   basis=aug-cc-pvtz
   ! singlet caspt2
 SET,SPIN=           0
 {multi;closed,16;occ,18;wf, 34,1,0,;state,1;maxiter,40}
